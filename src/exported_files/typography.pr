package com.mindvalley.uicomponents.compose

import androidx.compose.material3.Typography
import androidx.compose.runtime.Composable
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.FontStyle
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.TextUnit
import androidx.compose.ui.unit.sp
import com.mindvalley.uicomponents.compose.extensions.isCompactWidth
{[ const brands = ds.allBrands() /]}
{[ for brand in brands ]}
{[ const themesData = ds.allThemes(brand.id) /]}
{[ const colorTokensTree = ds.tokenGroupTreeByType("Typography", brand.id) /]}
{[ const typoData = groupTypography(themesData); /]}
{[/]}
{[ const keys = getTypoKeys() /]}
{[ for key in keys ]}
    {[ const mobileTypo = getMobileTypo(key) /]}
    {[ const tabletTypo = getTabletTypo(key) /]}
    {[ if (tabletTypo === undefined) ]}
val Typography.{[ inject "token_name" context mobileTypo.name /]}: TextStyle
@Composable
    get() =
        TextStyle(
            fontSize = {[ inject "token_name" context mobileTypo.fontSize /]},
            letterSpacing = {[ inject "token_name" context mobileTypo.letterSpacing /]},
            fontFamily = {[ inject "token_name" context mobileTypo.fontFamily /]},
            fontWeight = {[ inject "token_name" context mobileTypo.fontWeight /]},
            fontStyle = FontStyle.Normal,
            lineHeight = {[ inject "token_name" context mobileTypo.lineHeight /]}
)
    {[/]}
    {[ if (tabletTypo !== undefined) ]}
    
val Typography.{[ inject "token_name" context mobileTypo.name /]}: TextStyle
@Composable
    get() =
    if (isCompactWidth())
        TextStyle(
            fontSize = {[ inject "token_name" context mobileTypo.fontSize /]},
            letterSpacing = {[ inject "token_name" context mobileTypo.letterSpacing /]},
            fontFamily = {[ inject "token_name" context mobileTypo.fontFamily /]},
            fontWeight = {[ inject "token_name" context mobileTypo.fontWeight /]},
            fontStyle = FontStyle.Normal,
            lineHeight = {[ inject "token_name" context mobileTypo.lineHeight /]}
)
    else
        TextStyle(
            fontSize = {[ inject "token_name" context tabletTypo.fontSize /]},
            letterSpacing = {[ inject "token_name" context tabletTypo.letterSpacing /]},
            fontFamily = {[ inject "token_name" context tabletTypo.fontFamily /]},
            fontWeight = {[ inject "token_name" context tabletTypo.fontWeight /]},
            fontStyle = FontStyle.Normal,
            lineHeight = {[ inject "token_name" context tabletTypo.lineHeight /]}
)
    {[/]}
{[/]}